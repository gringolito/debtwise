{
  "problemMatcher": [
    {
      "owner": "go-test",
      "severity": "error",
      "pattern": [
        {
          "regexp": "\"Output\":\"\\s*(/[^\"]+?\\.go):(\\d+):(?:(\\d+):)? (.*)\\\\n\",\"OutputType\":\"error\"\\}$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    }
  ]
}
