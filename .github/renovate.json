{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    "security:gomodIndirectSecurityUpdates",
    "customManagers:dockerfileVersions"
  ],
  "timezone": "America/Sao_Paulo",
  "schedule": ["before 6am"],
  "labels": ["dependencies", "renovate"],
  "dependencyDashboard": true,
  "rangeStrategy": "bump",

  "description": "PR limits are disabled so pending updates are never silently queued out of sight.",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "minimumReleaseAge": null,

  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "renovate", "security"]
  },

  "lockFileMaintenance": {
    "enabled": true,
    "description": "Renovate's vulnerability alerts only cover direct dependencies, so a daily lock file refresh is what picks up fixes for transitive npm packages.",
    "schedule": ["before 6am"]
  },

  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor-patch (gomod)"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor-patch (npm)"
    },
    {
      "description": "Base images are tag-pinned, so digest updates refresh them between tag bumps.",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "minor-patch (docker)"
    },
    {
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "minor-patch (docker-compose)"
    },
    {
      "description": "Actions are SHA-pinned, so upgrades arrive as digest updates rather than version bumps.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "minor-patch (github-actions)"
    },
    {
      "description": "Toolchain pins split across mise.toml and .tool-versions; keep them in one PR.",
      "matchManagers": ["mise", "asdf"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor-patch (toolchain)"
    },
    {
      "description": "Bump the mise.toml go pin in the same PR as the go.mod go directive, so the two cannot drift.",
      "matchManagers": ["gomod", "mise"],
      "matchDepNames": ["go", "golang"],
      "groupName": "go toolchain"
    },
    {
      "description": "Node.js and npm are pinned in mise.toml, frontend/package.json devEngines and build/web.Dockerfile; bump every pin in one PR so they cannot drift.",
      "matchDepNames": ["node", "npm"],
      "groupName": "node toolchain"
    }
  ]
}
