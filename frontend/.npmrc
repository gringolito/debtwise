registry=https://registry.npmjs.org/

loglevel=warn

save-exact=true

# npm/cli#9800 makes fresh lock file resolution (Renovate's lockFileMaintenance) refuse
# registry tarballs with bundled dependencies unless this is `all`. Revisit and narrow it once
# that is fixed: https://github.com/npm/cli/issues/9800
allow-remote=all
