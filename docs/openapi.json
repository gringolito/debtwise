{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "request_id": {
            "description": "The ID of a request that failed with a 5xx, to quote when reporting the failure.",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "description": "Always ok: the server is up and its database answers.",
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "IndexHistory": {
        "additionalProperties": false,
        "properties": {
          "index": {
            "enum": [
              "tr",
              "poupanca",
              "selic_target",
              "selic",
              "ipca"
            ],
            "type": "string"
          },
          "values": {
            "description": "Every stored value of the index, oldest period first.",
            "items": {
              "$ref": "#/components/schemas/IndexValue"
            },
            "type": "array"
          }
        },
        "required": [
          "index",
          "values"
        ],
        "type": "object"
      },
      "IndexStatus": {
        "additionalProperties": false,
        "properties": {
          "failed_at": {
            "description": "When the latest refresh of the index failed. Absent unless status is failed.",
            "format": "date-time",
            "type": "string"
          },
          "index": {
            "enum": [
              "tr",
              "poupanca",
              "selic_target",
              "selic",
              "ipca"
            ],
            "type": "string"
          },
          "refreshed_at": {
            "description": "When the index was last refreshed successfully. Absent when it never was.",
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "description": "fresh: refreshed recently; stale: not refreshed recently; failed: the latest refresh failed; missing: never refreshed.",
            "enum": [
              "fresh",
              "stale",
              "failed",
              "missing"
            ],
            "type": "string"
          }
        },
        "required": [
          "index",
          "status"
        ],
        "type": "object"
      },
      "IndexValue": {
        "additionalProperties": false,
        "properties": {
          "fetched_at": {
            "description": "When the value was last fetched from its source.",
            "format": "date-time",
            "type": "string"
          },
          "period_end": {
            "description": "The last day of the period the value covers. Equals period_start when the source dates the value by one day or month.",
            "format": "date",
            "type": "string"
          },
          "period_start": {
            "description": "The first day of the period the value covers.",
            "format": "date",
            "type": "string"
          },
          "value": {
            "description": "The published value, as a decimal string in the index's unit.",
            "type": "string"
          }
        },
        "required": [
          "period_start",
          "period_end",
          "value",
          "fetched_at"
        ],
        "type": "object"
      },
      "MarketDataStatus": {
        "additionalProperties": false,
        "properties": {
          "indexes": {
            "description": "How fresh each index is.",
            "items": {
              "$ref": "#/components/schemas/IndexStatus"
            },
            "type": "array"
          },
          "refreshing": {
            "description": "Whether a refresh is pending or running.",
            "type": "boolean"
          }
        },
        "required": [
          "refreshing",
          "indexes"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "DebtWise API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Reports whether the server is up and able to read its data.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Check server health",
        "tags": [
          "Health"
        ]
      }
    },
    "/indexes/{index}/history": {
      "get": {
        "description": "Lists every published value of an index that has been fetched from its source.",
        "operationId": "index-history",
        "parameters": [
          {
            "description": "The index.",
            "in": "path",
            "name": "index",
            "required": true,
            "schema": {
              "description": "The index.",
              "enum": [
                "tr",
                "poupanca",
                "selic_target",
                "selic",
                "ipca"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexHistory"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List the history of an index",
        "tags": [
          "Indexes"
        ]
      }
    },
    "/market-data/refresh": {
      "post": {
        "description": "Starts refreshing every index from its source and answers at once with the market-data status. Poll the status until refreshing is false to see the outcome.",
        "operationId": "refresh-market-data",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataStatus"
                }
              }
            },
            "description": "Accepted"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Refresh the market data",
        "tags": [
          "Market data"
        ]
      }
    },
    "/market-data/status": {
      "get": {
        "description": "Reports, for each index, when it was last refreshed from its source and whether that data is stale or its latest refresh failed.",
        "operationId": "market-data-status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataStatus"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Report how fresh the market data is",
        "tags": [
          "Market data"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/api"
    }
  ]
}
