{
  "components": {
    "schemas": {
      "ContractRate": {
        "additionalProperties": false,
        "properties": {
          "basis": {
            "description": "The basis the rate was entered on; the other one is derived from it.",
            "enum": [
              "nominal",
              "effective"
            ],
            "type": "string"
          },
          "effective": {
            "description": "Annual rate on the effective basis, as a decimal fraction string.",
            "type": "string"
          },
          "effective_from": {
            "description": "Installments due on or after this date pay this rate, until a later row's date.",
            "format": "date",
            "type": "string"
          },
          "nominal": {
            "description": "Annual rate on the nominal basis, as a decimal fraction string.",
            "type": "string"
          }
        },
        "required": [
          "effective_from",
          "basis",
          "nominal",
          "effective"
        ],
        "type": "object"
      },
      "ContractRateTerms": {
        "additionalProperties": false,
        "properties": {
          "basis": {
            "description": "Whether the contract prints the rate as nominal or as effective.",
            "enum": [
              "nominal",
              "effective"
            ],
            "type": "string"
          },
          "effective_from": {
            "description": "Installments due on or after this date pay this rate, until a later row's date.",
            "format": "date",
            "type": "string"
          },
          "rate": {
            "description": "Annual rate as a decimal fraction string: 0.12 is 12% a year.",
            "pattern": "^(0|[1-9][0-9]{0,2})(\\.[0-9]{1,12})?$",
            "type": "string"
          }
        },
        "required": [
          "effective_from",
          "rate",
          "basis"
        ],
        "type": "object"
      },
      "CorrectionIndex": {
        "additionalProperties": false,
        "properties": {
          "index": {
            "description": "The index the value belongs to.",
            "enum": [
              "tr",
              "poupanca_yield",
              "selic_target",
              "selic",
              "ipca"
            ],
            "type": "string"
          },
          "period_end": {
            "description": "The last day of the period the value covers. Equals period_start when the index is dated by month.",
            "format": "date",
            "type": "string"
          },
          "period_start": {
            "description": "The first day of the period the value covers.",
            "format": "date",
            "type": "string"
          },
          "status": {
            "description": "published: the balance was corrected by the published value; missing: no value is available for the period yet, so the balance was not corrected by it.",
            "enum": [
              "published",
              "missing"
            ],
            "type": "string"
          },
          "value": {
            "description": "The index value for the period, in percent, as a decimal string. Absent when status is missing.",
            "type": "string"
          }
        },
        "required": [
          "index",
          "status",
          "period_start",
          "period_end"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "request_id": {
            "description": "The ID of a request that failed with a 5xx, to quote when reporting the failure.",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Fee": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "description": "Monthly amount, in reais, as a decimal string.",
            "pattern": "^(0|[1-9][0-9]{0,14})(\\.[0-9]{1,2})?$",
            "type": "string"
          },
          "effective_from": {
            "description": "Installments due on or after this date pay this fee, until a later row's date.",
            "format": "date",
            "type": "string"
          }
        },
        "required": [
          "effective_from",
          "amount"
        ],
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "description": "Always ok: the server is up and its database answers.",
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "IndexHistory": {
        "additionalProperties": false,
        "properties": {
          "index": {
            "enum": [
              "tr",
              "poupanca_yield",
              "selic_target",
              "selic",
              "ipca"
            ],
            "type": "string"
          },
          "values": {
            "description": "The values of the index, oldest period first.",
            "items": {
              "$ref": "#/components/schemas/IndexValue"
            },
            "type": "array"
          }
        },
        "required": [
          "index",
          "values"
        ],
        "type": "object"
      },
      "IndexStatus": {
        "additionalProperties": false,
        "properties": {
          "failed_at": {
            "description": "When the latest refresh of the index failed. Absent unless status is failed.",
            "format": "date-time",
            "type": "string"
          },
          "index": {
            "enum": [
              "tr",
              "poupanca_yield",
              "selic_target",
              "selic",
              "ipca"
            ],
            "type": "string"
          },
          "refreshed_at": {
            "description": "When the index was last refreshed successfully. Absent when it never was.",
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "description": "fresh: refreshed recently; stale: not refreshed recently; failed: the latest refresh failed; missing: never refreshed.",
            "enum": [
              "fresh",
              "stale",
              "failed",
              "missing"
            ],
            "type": "string"
          }
        },
        "required": [
          "index",
          "status"
        ],
        "type": "object"
      },
      "IndexValue": {
        "additionalProperties": false,
        "properties": {
          "fetched_at": {
            "description": "When the value was last fetched from its source.",
            "format": "date-time",
            "type": "string"
          },
          "period_end": {
            "description": "The last day of the period the value covers. Equals period_start when the source dates the value by one day or month.",
            "format": "date",
            "type": "string"
          },
          "period_start": {
            "description": "The first day of the period the value covers.",
            "format": "date",
            "type": "string"
          },
          "value": {
            "description": "The published value, as a decimal string in the index's unit.",
            "type": "string"
          }
        },
        "required": [
          "period_start",
          "period_end",
          "value",
          "fetched_at"
        ],
        "type": "object"
      },
      "MarketDataStatus": {
        "additionalProperties": false,
        "properties": {
          "indexes": {
            "description": "How fresh each index is.",
            "items": {
              "$ref": "#/components/schemas/IndexStatus"
            },
            "type": "array"
          },
          "refreshing": {
            "description": "Whether a refresh is in progress.",
            "type": "boolean"
          }
        },
        "required": [
          "refreshing",
          "indexes"
        ],
        "type": "object"
      },
      "MonthlyRate": {
        "additionalProperties": false,
        "properties": {
          "effective_from": {
            "description": "Installments due on or after this date pay this rate, until a later row's date.",
            "format": "date",
            "type": "string"
          },
          "rate": {
            "description": "Monthly rate as a decimal fraction string: 0.0003 is 0.03% a month.",
            "pattern": "^(0|[1-9][0-9]{0,2})(\\.[0-9]{1,12})?$",
            "type": "string"
          }
        },
        "required": [
          "effective_from",
          "rate"
        ],
        "type": "object"
      },
      "MortgageTerms": {
        "additionalProperties": false,
        "properties": {
          "amortization_system": {
            "description": "How each installment splits into amortization and interest.",
            "enum": [
              "sac",
              "price"
            ],
            "type": "string"
          },
          "appraisal_value": {
            "description": "Appraisal value of the property, in reais, as a decimal string.",
            "pattern": "^(0|[1-9][0-9]{0,14})(\\.[0-9]{1,2})?$",
            "type": "string"
          },
          "contract_date": {
            "description": "Date the contract was signed.",
            "format": "date",
            "type": "string"
          },
          "contract_rates": {
            "description": "The contract's interest rate, and its later changes.",
            "items": {
              "$ref": "#/components/schemas/ContractRateTerms"
            },
            "type": "array"
          },
          "dfi_rates": {
            "description": "The DFI (property damage insurance) rate, and its later changes.",
            "items": {
              "$ref": "#/components/schemas/MonthlyRate"
            },
            "type": "array"
          },
          "fees": {
            "description": "The monthly admin fee, and its later changes.",
            "items": {
              "$ref": "#/components/schemas/Fee"
            },
            "type": "array"
          },
          "first_installment_date": {
            "description": "Due date of the first installment.",
            "format": "date",
            "type": "string"
          },
          "indexer": {
            "description": "The index the contract corrects the outstanding balance by: TR, the poupança yield, IPCA, or none for a fixed-rate contract.",
            "enum": [
              "none",
              "tr",
              "poupanca_yield",
              "ipca"
            ],
            "type": "string"
          },
          "mip_rates": {
            "description": "The MIP (life and disability insurance) rate, and its changes as the borrower moves into a new age band.",
            "items": {
              "$ref": "#/components/schemas/MonthlyRate"
            },
            "type": "array"
          },
          "original_amount": {
            "description": "Amount borrowed, in reais, as a decimal string.",
            "pattern": "^(0|[1-9][0-9]{0,14})(\\.[0-9]{1,2})?$",
            "type": "string"
          },
          "term_months": {
            "description": "Number of monthly installments.",
            "format": "int64",
            "maximum": 600,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "contract_date",
          "original_amount",
          "term_months",
          "first_installment_date",
          "amortization_system",
          "indexer",
          "appraisal_value",
          "contract_rates",
          "mip_rates",
          "dfi_rates",
          "fees"
        ],
        "type": "object"
      },
      "RegisteredMortgage": {
        "additionalProperties": false,
        "properties": {
          "amortization_system": {
            "description": "How each installment splits into amortization and interest.",
            "enum": [
              "sac",
              "price"
            ],
            "type": "string"
          },
          "appraisal_value": {
            "description": "Appraisal value of the property, in reais, as a decimal string.",
            "type": "string"
          },
          "contract_date": {
            "description": "Date the contract was signed.",
            "format": "date",
            "type": "string"
          },
          "contract_rates": {
            "description": "The contract's interest rate and its later changes, in date order.",
            "items": {
              "$ref": "#/components/schemas/ContractRate"
            },
            "type": "array"
          },
          "dfi_rates": {
            "description": "The DFI (property damage insurance) rate and its changes, in date order.",
            "items": {
              "$ref": "#/components/schemas/MonthlyRate"
            },
            "type": "array"
          },
          "fees": {
            "description": "The monthly admin fee and its changes, in date order.",
            "items": {
              "$ref": "#/components/schemas/Fee"
            },
            "type": "array"
          },
          "first_installment_date": {
            "description": "Due date of the first installment.",
            "format": "date",
            "type": "string"
          },
          "indexer": {
            "description": "The index the contract corrects the outstanding balance by: TR, the poupança yield, IPCA, or none for a fixed-rate contract.",
            "enum": [
              "none",
              "tr",
              "poupanca_yield",
              "ipca"
            ],
            "type": "string"
          },
          "mip_rates": {
            "description": "The MIP (life and disability insurance) rate and its changes, in date order.",
            "items": {
              "$ref": "#/components/schemas/MonthlyRate"
            },
            "type": "array"
          },
          "original_amount": {
            "description": "Amount borrowed, in reais, as a decimal string.",
            "type": "string"
          },
          "term_months": {
            "description": "Number of monthly installments.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "contract_date",
          "original_amount",
          "term_months",
          "first_installment_date",
          "amortization_system",
          "indexer",
          "appraisal_value",
          "contract_rates",
          "mip_rates",
          "dfi_rates",
          "fees"
        ],
        "type": "object"
      },
      "Schedule": {
        "additionalProperties": false,
        "properties": {
          "installments": {
            "description": "Every installment of the mortgage, in due date order.",
            "items": {
              "$ref": "#/components/schemas/ScheduledInstallment"
            },
            "type": "array"
          }
        },
        "required": [
          "installments"
        ],
        "type": "object"
      },
      "ScheduledInstallment": {
        "additionalProperties": false,
        "properties": {
          "amortization": {
            "description": "Outstanding balance paid off, in reais, as a decimal string.",
            "type": "string"
          },
          "amount": {
            "description": "Total the installment charges, in reais, as a decimal string.",
            "type": "string"
          },
          "correction": {
            "description": "Indexer correction added to the outstanding balance before interest is charged, in reais, as a decimal string.",
            "type": "string"
          },
          "dfi": {
            "description": "DFI (property damage insurance) premium, in reais, as a decimal string.",
            "type": "string"
          },
          "due_date": {
            "description": "Date the installment falls due.",
            "format": "date",
            "type": "string"
          },
          "fee": {
            "description": "Admin fee, in reais, as a decimal string.",
            "type": "string"
          },
          "index_values": {
            "description": "The index values behind the correction, oldest period first. Empty when no index value applies to the installment.",
            "items": {
              "$ref": "#/components/schemas/CorrectionIndex"
            },
            "type": "array"
          },
          "interest": {
            "description": "Interest charged, in reais, as a decimal string.",
            "type": "string"
          },
          "mip": {
            "description": "MIP (life and disability insurance) premium, in reais, as a decimal string.",
            "type": "string"
          },
          "number": {
            "description": "Installment number, counting from 1.",
            "format": "int64",
            "type": "integer"
          },
          "outstanding_balance": {
            "description": "Outstanding balance after the installment, in reais, as a decimal string.",
            "type": "string"
          }
        },
        "required": [
          "number",
          "due_date",
          "correction",
          "index_values",
          "interest",
          "amortization",
          "mip",
          "dfi",
          "fee",
          "amount",
          "outstanding_balance"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "DebtWise API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Reports whether the server is up and able to read its data.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Check server health",
        "tags": [
          "Health"
        ]
      }
    },
    "/indexes/{index}/history": {
      "get": {
        "description": "Lists the published values of an index, as of its latest refresh.",
        "operationId": "index-history",
        "parameters": [
          {
            "description": "The index.",
            "in": "path",
            "name": "index",
            "required": true,
            "schema": {
              "description": "The index.",
              "enum": [
                "tr",
                "poupanca_yield",
                "selic_target",
                "selic",
                "ipca"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexHistory"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List the history of an index",
        "tags": [
          "Indexes"
        ]
      }
    },
    "/market-data/refresh": {
      "post": {
        "description": "Starts refreshing every index from its source and answers at once with the market-data status. Poll the status until refreshing is false to see the outcome.",
        "operationId": "refresh-market-data",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataStatus"
                }
              }
            },
            "description": "Accepted"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Refresh the market data",
        "tags": [
          "Market data"
        ]
      }
    },
    "/market-data/status": {
      "get": {
        "description": "Reports, for each index, when it was last refreshed from its source and whether that data is stale or its latest refresh failed.",
        "operationId": "market-data-status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataStatus"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Report how fresh the market data is",
        "tags": [
          "Market data"
        ]
      }
    },
    "/mortgage": {
      "delete": {
        "description": "Deletes the registered mortgage with all its terms.",
        "operationId": "delete-mortgage",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Delete the mortgage",
        "tags": [
          "Mortgage"
        ]
      },
      "get": {
        "description": "Returns the registered mortgage's terms, with each contract rate on both the nominal and the effective basis.",
        "operationId": "read-mortgage",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisteredMortgage"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Read the mortgage",
        "tags": [
          "Mortgage"
        ]
      },
      "put": {
        "description": "Registers the owner's mortgage, or replaces the terms of the one already registered, and returns it as a read would.",
        "operationId": "save-mortgage",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MortgageTerms"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisteredMortgage"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Register or edit the mortgage",
        "tags": [
          "Mortgage"
        ]
      }
    },
    "/mortgage/schedule": {
      "get": {
        "description": "Returns the registered mortgage's installments month by month, to check against bank statements.",
        "operationId": "read-mortgage-schedule",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Schedule"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Read the mortgage schedule",
        "tags": [
          "Mortgage"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/api"
    }
  ]
}
